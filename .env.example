# ==========================================================
# SETU - AI-Assisted Schedule Linking & Planner Review
# SIH 2026 - Problem Statement: SIH26122 (Oil India Limited)
# ==========================================================

# Supabase server-side configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# REQUIRED by server-side workers/importers. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Frontend-only Supabase configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Matching Engine Thresholds
# Scores >= 0.82 are routed to High Confidence (Suggested Auto-Link)
# Scores between 0.55 and 0.81 are routed to Medium Confidence (Planner Review Queue)
# Scores < 0.55 are routed to Low / Flagged for Review (Never dropped)
THRESHOLD_HIGH_CONFIDENCE=0.82
THRESHOLD_MEDIUM_CONFIDENCE=0.55

# Execution Mode
# Default for fresh clone: False (connects to live Supabase project).
# Set USE_LOCAL_MOCK_DB=True to operate with local JSON fallback (data/local_supabase_mock.json)
USE_LOCAL_MOCK_DB=False

# Application Settings
DEBUG_MODE=False
