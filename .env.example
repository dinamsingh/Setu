# ==========================================================
# SETU - AI-Assisted Schedule Linking & Planner Review
# SIH 2026 - Problem Statement: SIH26122 (Oil India Limited)
# ==========================================================

# Supabase PostgreSQL Configuration
# Note: Keep service-role key secure; never import it into client/Streamlit scripts!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Matching Engine Thresholds
# Scores >= 0.82 are routed to High Confidence (Suggested Auto-Link)
# Scores between 0.55 and 0.81 are routed to Medium Confidence (Planner Review Queue)
# Scores < 0.55 are routed to Low / Flagged for Review (Never dropped)
THRESHOLD_HIGH_CONFIDENCE=0.82
THRESHOLD_MEDIUM_CONFIDENCE=0.55

# Execution Mode
# When USE_LOCAL_MOCK_DB=True, SETU operates with local SQLite/JSON fallback for offline demo safety
USE_LOCAL_MOCK_DB=True

# Application Settings
STREAMLIT_SERVER_PORT=8501
DEBUG_MODE=False
